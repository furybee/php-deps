{
    "name": "furybee/php-deps",
    "description": "Static analysis tool for visualizing PHP class dependencies and call graphs",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "DepsGraph\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DepsGraph\\Tests\\": "tests/"
        }
    },
    "bin": [
        "analyze.php"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
